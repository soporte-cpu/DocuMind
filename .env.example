# Configuración de DocuMind Enterprise
# Copia este archivo como .env y completa los valores necesarios

# [REQUERID] Tu clave de API de OpenAI para el motor RAG y resúmenes inteligentes
OPENAI_API_KEY=tu_clave_aqui

# [OPCIONAL] Clave secreta para la firma de tokens JWT (Sesiones)
# Si no se define, se usará una por defecto para desarrollo.
SECRET_KEY=cambia_esta_clave_en_produccion

# [OPCIONAL] Configuración de base de datos
# Por defecto utiliza SQLite en data/documind.db
# DATABASE_URL=sqlite:///./data/documind.db
